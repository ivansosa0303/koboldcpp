                summary: "Iván y Razi encuentran una Luz del Destino. Un anciano guardián le entrega a Iván un Fragmento de Esencia.",
                panels: [
                    { type: 'narration', text: "El primer encuentro con las Luces del Destino cambió todo para Iván. Fue durante una noche sin estrellas, mientras él y Razi descansaban en un claro rodeado de árboles retorcidos que parecían susurrar secretos antiguos.", imagePrompt: `Manga panel: Noche. ${CHAR_DESC.IVAN} y ${CHAR_DESC.RAZI} en un claro con árboles retorcidos. ${CHAR_DESC.IVAN} está despierto, inquieto.`, imageUrl: null, generated: false, keyScene: true },
