                panels: [
                    { type: 'narration', text: "Túbula los convocó al amanecer... Una anomalía ha surgido en una dimensión cercana, una grieta que amenaza con desestabilizar el equilibrio.", imagePrompt: `Manga panel: ${CHAR_DESC.TUBULA} con expresión seria, mostrando a ${CHAR_DESC.IVAN} y ${CHAR_DESC.RAZI} un holograma de una grieta dimensional oscura.`, imageUrl: null, generated: false, keyScene: true },
                    { type: 'dialogue', character: 'Túbula', text: "Es conocida como el Eco de las Sombras. Deben neutralizarla antes de que crezca y consuma toda la dimensión." },
                    { type: 'narration', text: "Con estas palabras, Túbula extendió su mano, abriendo un portal frente a ellos. Iván sintió un escalofrío recorrer su espalda mientras cruzaban el umbral...", imagePrompt: `Manga panel: ${CHAR_DESC.TUBULA} abriendo un portal brillante y arremolinado. ${CHAR_DESC.IVAN} y ${CHAR_DESC.RAZI} a punto de cruzarlo.`, imageUrl: null, generated: false, keyScene: true },
                    { type: 'narration', text: "El mundo al que llegaron era un lugar extraño y hostil. El cielo estaba cubierto de nubes negras que parecían moverse con vida propia, y el suelo estaba cubierto de escombros flotantes que desafiaban las leyes de la gravedad.", imagePrompt: `Manga panel: Paisaje de la dimensión fracturada: cielo con nubes negras, escombros flotantes. ${CHAR_DESC.IVAN} y ${CHAR_DESC.RAZI} observando.`, imageUrl: null, generated: false, keyScene: true },
                    { type: 'narration', text: "En el centro de todo, una columna de energía oscura pulsaba como un corazón enfermo.", imagePrompt: `Manga panel: La imponente columna de energía oscura pulsando en el centro de la dimensión fracturada.`, imageUrl: null, generated: false, keyScene: true },
                    { type: 'narration', text: "Avanzaron con cautela... Figuras etéreas emergieron de las sombras, sus formas fluctuando entre lo humano y lo monstruoso. Eran fragmentos de conciencia atrapados en la anomalía...", imagePrompt: `Manga panel: Figuras etéreas y sombrías, mitad humanas, mitad monstruosas, emergiendo de las sombras hacia ${CHAR_DESC.IVAN} y ${CHAR_DESC.RAZI}.`, imageUrl: null, generated: false, keyScene: true },
                    { type: 'dialogue', character: 'Razi', text: "No podemos simplemente destruirlos. Están atrapados aquí." },
                    { type: 'dialogue', character: 'Iván', text: "Entonces tendremos que liberarlos." },
                    { type: 'narration', text: "Trabajando juntos, Iván y Razi comenzaron a canalizar sus poderes combinados. Iván usó su dominio sobre la oscuridad para calmar a las criaturas, mientras Razi utilizaba su conexión con las tormentas para purificar sus almas.", imagePrompt: `Manga panel: ${CHAR_DESC.IVAN} usando energía oscura para calmar a las criaturas, ${CHAR_DESC.RAZI} usando energía de tormenta para purificar otras.`, imageUrl: null, generated: false, keyScene: true },
                    { type: 'narration', text: "Sin embargo, la columna central seguía intacta... Iván cerró los ojos y buscó dentro de sí mismo... su cuerpo estaba envuelto en una energía brillante pero contenida.", imagePrompt: `Manga panel: ${CHAR_DESC.IVAN} concentrado, una energía brillante y controlada lo envuelve, preparándose para un gran esfuerzo.`, imageUrl: null, generated: false, keyScene: true },
                    { type: 'dialogue', character: 'Iván', text: "Razi, necesito tu ayuda. Juntos, podemos usar las Cadenas de Luz y Oscuridad para sellar esta anomalía." },
                    { type: 'narration', text: "Ambos unieron sus fuerzas, creando una red de energía que envolvió la columna oscura. La anomalía comenzó a resistirse... Finalmente... lograron sellar la anomalía...", imagePrompt: `Manga panel: ${CHAR_DESC.IVAN} y ${CHAR_DESC.RAZI} uniendo sus poderes, creando una red de energía de luz y oscuridad que sella la columna de energía oscura. Esfuerzo máximo.`, imageUrl: null, generated: false, keyScene: true }
