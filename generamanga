        async function prepareChapterForCinemaMode(chapterId) {
            const chapter = mangaData.find(ch => ch.id === chapterId);
            if (!chapter || (chapter.panels && chapter.panels[0] && chapter.panels[0].isPlaceholder)) { 
                return true; 
            }

            const panelsToGenerate = chapter.panels.filter(panel => panel.imagePrompt && !panel.generated);
            if (panelsToGenerate.length > 0) {
                loadingIndicatorText.textContent = "Preparando imágenes para Modo Cine...";
                loadingIndicator.classList.remove('hidden');
                await Promise.all(panelsToGenerate.map(async (panel) => {
                    const generatedUrl = await generateImage(panel.imagePrompt);
                    panel.imageUrl = generatedUrl;
                    panel.generated = true;
                }));
                loadingIndicator.classList.add('hidden');
            }
            return true; 
        }


        async function loadChapter(chapterId, requestedPageIndex = 0, fromContinuation = false) {
            if (!fromContinuation) saveProgress(); 

            viewMode = 'manga'; updateViewModeUI(); 
            const chapterExistsInData = mangaData.some(ch => ch.id === chapterId);
            if (!chapterExistsInData && chapterId.startsWith("capitulo")) { 
                isPresentationMode = false; updatePresentationModeUI(); currentChapterId = chapterId; currentPage = 0;
                mangaDisplay.innerHTML = ''; 
                const placeholderPanel = { type: 'placeholder', text: `Contenido para ${chapterId.replace("capitulo", "Capítulo ")} no implementado.`, isPlaceholder: true, originalIndex: 0 };
                chapterPanelsCache = [placeholderPanel]; 
                const panelElement = renderPanel(placeholderPanel, 0, 1); mangaDisplay.appendChild(panelElement);
                setTimeout(() => panelElement.classList.add('visible'), 50);
                summaryDisplay.classList.add('hidden'); updatePaginationControls(1); updateScreenArrowStates(); return;
            }
            const chapter = mangaData.find(ch => ch.id === chapterId); if (!chapter) return; 
            
            const alreadyOnPage = currentChapterId === chapterId && currentPage === requestedPageIndex && !isPresentationMode && chapter.panels.every(p => !p.keyScene || p.generated);
            if (alreadyOnPage) { renderCurrentPage(); return; }


            if(!isPresentationMode) {
                 isPresentationMode = false; 
                 updatePresentationModeUI();
            }
            currentChapterId = chapterId; 
            currentPage = requestedPageIndex; 
            currentPanelIndexInPresentation = requestedPageIndex; 
            
            chapterPanelsCache = chapter.panels.map((p, i) => ({...p, originalIndex: i}));
            chapterSelect.value = chapterId;

            if (!isPresentationMode) { // Only generate for current page in pagination mode
                const start = currentPage * panelsPerPage; // panelsPerPage is 1
                const end = start + panelsPerPage;
                const panelsForCurrentPage = chapter.panels.slice(start, end);
                const keyPanelsToGenerateOnLoad = panelsForCurrentPage.filter(panel => panel.keyScene && !panel.generated);

                if (keyPanelsToGenerateOnLoad.length > 0) {
                    loadingIndicatorText.textContent = "Generando imágenes del manga..."; loadingIndicator.classList.remove('hidden');
                    await Promise.all(keyPanelsToGenerateOnLoad.map(async (panel) => {
                        if (panel.imagePrompt && !panel.generated) {
                            const generatedUrl = await generateImage(panel.imagePrompt); panel.imageUrl = generatedUrl; panel.generated = true; 
                        }
                    }));
                    loadingIndicator.classList.add('hidden');
                }
            }
            // For Cinema Mode, images are pre-generated by prepareChapterForCinemaMode when entering the mode.
            
            renderCurrentPage();
            if (chapter.summary && !chapter.isPlaceholder && !(chapterPanelsCache.length > 0 && chapterPanelsCache[0].isPlaceholder)) { 
                 summaryText.textContent = chapter.summary; summaryDisplay.classList.remove('hidden'); 
            } else { 
                summaryDisplay.classList.add('hidden'); 
            }
        }

        function renderCurrentPage() {
            mangaDisplay.innerHTML = ''; 
            const chapter = mangaData.find(ch => ch.id === currentChapterId);
            let totalPanelsInChapter = 0;
            if (chapter) totalPanelsInChapter = chapter.panels.length;
            else if (currentChapterId && currentChapterId.startsWith("capitulo")) totalPanelsInChapter = 1; 

            if (!chapter && currentChapterId && currentChapterId.startsWith("capitulo")) { 
                const placeholderPanel = { type: 'placeholder', text: `Contenido para ${currentChapterId.replace("capitulo", "Capítulo ")} no implementado.`, isPlaceholder: true, originalIndex: 0 };
                chapterPanelsCache = [placeholderPanel];
                const panelElement = renderPanel(placeholderPanel, 0, 1); mangaDisplay.appendChild(panelElement);
                setTimeout(() => panelElement.classList.add('visible'), 50);
                if (isPresentationMode) { nextPanelButton.disabled = true; } else { updatePaginationControls(1); }
                updateScreenArrowStates(); return;
            }
            if (!chapter || !chapterPanelsCache || chapterPanelsCache.length === 0) return;

            if (isPresentationMode) {
                paginationControls.classList.add('hidden'); nextPanelButton.classList.remove('hidden');
                screenPrevArrow.classList.add('hidden'); screenNextArrow.classList.add('hidden');
                if (currentPanelIndexInPresentation < chapterPanelsCache.length) {
                    const panelData = chapterPanelsCache[currentPanelIndexInPresentation];
                    const panelElement = renderPanel(panelData, currentPanelIndexInPresentation, totalPanelsInChapter);
                    mangaDisplay.appendChild(panelElement); setTimeout(() => panelElement.classList.add('visible'), 50);
                    panelElement.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    if (autoReadToggle.checked && panelData.text && !panelData.isPlaceholder) {
                        const ttsButton = panelElement.querySelector('.tts-button');
                        if (ttsButton) speak(ttsButton.dataset.textToSpeak, ttsButton, () => {
                             if (autoAdvanceToggle.checked) showNextPanelInPresentation();
                        });
                    }
                }
                nextPanelButton.disabled = currentPanelIndexInPresentation >= chapterPanelsCache.length - 1;
            } else {
                paginationControls.classList.remove('hidden'); nextPanelButton.classList.add('hidden');
                screenPrevArrow.classList.remove('hidden'); screenPrevArrow.classList.add('sm:flex');
                screenNextArrow.classList.remove('hidden'); screenNextArrow.classList.add('sm:flex');
                const totalPanels = chapter.panels.length; 
                if (currentPage < totalPanels) {
                    const panelData = chapter.panels[currentPage];
                    const panelElement = renderPanel(panelData, currentPage, totalPanels);
                    mangaDisplay.appendChild(panelElement); setTimeout(() => panelElement.classList.add('visible'), 50);
                }
                updatePaginationControls(totalPanels); if (!isPresentationMode) window.scrollTo(0, 0);
            }
            updateScreenArrowStates();
            if (!isPresentationMode) saveProgress(); 
        }

        function updatePaginationControls(totalPages) {
            pageIndicator.textContent = `Panel ${currentPage + 1} de ${totalPages}`;
            prevPageButton.disabled = currentPage === 0; nextPageButton.disabled = currentPage >= totalPages - 1;
        }
        
        async function togglePresentationMode() { 
            if (!isPresentationMode) { 
                const chapter = mangaData.find(ch => ch.id === currentChapterId);
                if (!chapter && !(currentChapterId && currentChapterId.startsWith("capitulo"))) return;
                
                await prepareChapterForCinemaMode(currentChapterId); 
                
                isPresentationMode = true;
                currentPanelIndexInPresentation = currentPage; 
                if (chapter) { 
                    chapterPanelsCache = chapter.panels.map((p, i) => ({...p, originalIndex: i}));
                } else { 
                    const placeholderPanel = { type: 'placeholder', text: `Contenido para ${currentChapterId.replace("capitulo", "Capítulo ")} no implementado.`, isPlaceholder: true, originalIndex: 0 };
                    chapterPanelsCache = [placeholderPanel];
                }
            } else { 
                isPresentationMode = false;
                currentPage = currentPanelIndexInPresentation; 
                if (synth.speaking) synth.cancel();
            }
            updatePresentationModeUI(); 
            renderCurrentPage(); 
        }


        function showNextPanelInPresentation() {
            if (!isPresentationMode || !chapterPanelsCache || chapterPanelsCache.length === 0) return;
            if (currentPanelIndexInPresentation < chapterPanelsCache.length - 1) { 
                currentPanelIndexInPresentation++; 
                renderCurrentPage(); 
                saveProgress(); 
            }
        }
        function showPrevPanelInPresentation() {
            if (!isPresentationMode || !chapterPanelsCache || chapterPanelsCache.length === 0) return;
            if (currentPanelIndexInPresentation > 0) { 
                currentPanelIndexInPresentation--; 
                renderCurrentPage();
                saveProgress(); 
            }
        }

        function navigatePage(direction) {
            if (viewMode === 'gallery') return; 
            if (isPresentationMode) {
                if (direction === 'next') showNextPanelInPresentation(); else if (direction === 'prev') showPrevPanelInPresentation();
            } else {
                const chapter = mangaData.find(ch => ch.id === currentChapterId); let totalPanelsOrPages;
                if (chapter) { totalPanelsOrPages = chapter.panels.length; } else { totalPanelsOrPages = 1; }
                if (direction === 'next' && currentPage < totalPanelsOrPages - 1) { currentPage++; renderCurrentPage(); } 
                else if (direction === 'prev' && currentPage > 0) { currentPage--; renderCurrentPage(); }
            }
        }
        
        function updateScreenArrowStates() {
             if (viewMode === 'gallery') {
                screenPrevArrow.classList.add('hidden'); screenNextArrow.classList.add('hidden'); return;
            }
            screenPrevArrow.classList.remove('hidden'); screenPrevArrow.classList.add('sm:flex');
            screenNextArrow.classList.remove('hidden'); screenNextArrow.classList.add('sm:flex');

            if (isPresentationMode) {
                screenPrevArrow.disabled = currentPanelIndexInPresentation <= 0;
                screenNextArrow.disabled = currentPanelIndexInPresentation >= chapterPanelsCache.length - 1;
            } else {
                 const chapter = mangaData.find(ch => ch.id === currentChapterId); let totalItems = 1; 
                 if (chapter) { totalItems = chapter.panels.length; }
                screenPrevArrow.disabled = currentPage <= 0; screenNextArrow.disabled = currentPage >= totalItems - 1;
            }
        }

        function closeModalOutside(event, modalId) { 
            const modal = document.getElementById(modalId);
            if (event.target === modal) { modal.style.display = 'none'; } 
        }
        
        async function renderCharacterGallery() {
            characterGalleryGrid.innerHTML = ''; 
            loadingIndicatorText.textContent = "Generando Galería de Personajes...";
            loadingIndicator.classList.remove('hidden');
            for (const char of characterGalleryData) {
                const card = document.createElement('div'); card.className = 'character-card';
                const imgContainer = document.createElement('div'); imgContainer.className = 'character-card-image-container';
                const img = document.createElement('img'); img.className = 'character-card-image'; img.alt = `Retrato de ${char.name}`;
                if (!char.generated || !char.imageUrl) {
                    const generatedUrl = await generateImage(char.imagePrompt); char.imageUrl = generatedUrl; char.generated = true;
                }
                img.src = char.imageUrl; img.onerror = () => img.src = `https://placehold.co/300x300/252538/A0A0CC?text=${char.name.replace(/\s/g,'+')}`;
                imgContainer.appendChild(img);
                card.innerHTML += `<h5>${char.name}</h5><p>${char.description}</p>`;
                if(char.powers) card.innerHTML += `<p><strong>Poderes:</strong> ${char.powers}</p>`;
                if(char.skills) card.innerHTML += `<p><strong>Habilidades:</strong> ${char.skills}</p>`;
                if(char.items) card.innerHTML += `<p><strong>Objetos Clave:</strong> ${char.items}</p>`;
                card.insertBefore(imgContainer, card.firstChild); characterGalleryGrid.appendChild(card);
            }
            if (!multiverseMapImage.dataset.generated) {
                 const mapPrompt = "Mapa conceptual del multiverso estilo fantasía cósmica, mostrando dimensiones interconectadas, portales brillantes, nebulosas de colores y quizás una estructura central como 'El Umbral'. Épico, detallado, evocador.";
                 const mapUrl = await generateImage(mapPrompt); multiverseMapImage.src = mapUrl; multiverseMapImage.dataset.generated = true;
            }
            loadingIndicator.classList.add('hidden');
        }

        function toggleGalleryView() {
            if (viewMode === 'manga') { viewMode = 'gallery'; renderCharacterGallery(); } 
            else { viewMode = 'manga'; }
            updateViewModeUI(); 
        }

        const PROGRESS_KEY = 'ivanRazielMangaProgress_v2'; 
        function saveProgress() {
            if(currentChapterId && (isPresentationMode || currentPage !== undefined)) { 
                const progress = {
                    chapterId: currentChapterId,
                    panelIndex: isPresentationMode ? currentPanelIndexInPresentation : currentPage,
                    language: currentLanguage,
                    voiceURI: selectedVoiceURI,
                    autoRead: autoReadToggle.checked,
                    autoAdvance: autoAdvanceToggle.checked
                };
                localStorage.setItem(PROGRESS_KEY, JSON.stringify(progress));
            }
        }

        function loadProgress() {
            const savedProgress = localStorage.getItem(PROGRESS_KEY);
            if (savedProgress) {
                const progress = JSON.parse(savedProgress);
                const chapterObject = mangaData.find(ch => ch.id === progress.chapterId);
                const chapterTitle = chapterObject ? chapterObject.title.split(':')[0] : progress.chapterId.replace("capitulo", "Capítulo ");
                
                continueModalText.textContent = `¿Deseas continuar desde ${chapterTitle}, panel ${progress.panelIndex + 1}?`;
                continueModal.style.display = 'flex';

                continueYesButton.onclick = () => {
                    currentLanguage = progress.language || 'es-MX';
                    languageSelect.value = currentLanguage;
                    selectedVoiceURI = progress.voiceURI || null;
                    autoReadToggle.checked = progress.autoRead || false;
                    autoAdvanceToggle.checked = progress.autoAdvance || false;

                    if (synth.getVoices().length) { 
                        populateVoices();
                        if(selectedVoiceURI) voiceSelect.value = selectedVoiceURI;
                    } else { 
                        speechSynthesis.onvoiceschanged = () => {
                            populateVoices();
                            if(selectedVoiceURI) voiceSelect.value = selectedVoiceURI;
                            speechSynthesis.onvoiceschanged = null; 
                        };
                    }
                    
                    loadChapter(progress.chapterId, progress.panelIndex, true);
                    continueModal.style.display = 'none';
                };
                continueNoButton.onclick = () => {
                    localStorage.removeItem(PROGRESS_KEY);
                    continueModal.style.display = 'none';
                    loadChapter(currentChapterId, 0, true); 
                };

            } else {
                loadChapter(currentChapterId, 0, true); 
            }
        }


        function initialize() {
            const prologueOption = document.createElement('option'); prologueOption.value = "prologo";
            prologueOption.textContent = "Prólogo: El Llamado del Vacío"; chapterSelect.appendChild(prologueOption);
            for (let i = 1; i <= 60; i++) {
                const option = document.createElement('option'); option.value = `capitulo${i}`;
                const chapterData = mangaData.find(ch => ch.id === `capitulo${i}`);
                option.textContent = chapterData ? `Capítulo ${i}: ${chapterData.title.split(': ')[1] || `Título Pendiente ${i}`}` : `Capítulo ${i}`;
                chapterSelect.appendChild(option);
            }
            chapterSelect.value = currentChapterId; 
            chapterSelect.onchange = () => { loadChapter(chapterSelect.value); };
            
            languageSelect.onchange = () => {
                currentLanguage = languageSelect.value;
                selectedVoiceURI = null; 
                populateVoices();
                saveProgress(); 
            };
            voiceSelect.onchange = () => {
                selectedVoiceURI = voiceSelect.value;
                saveProgress(); 
            };
            autoReadToggle.onchange = saveProgress;
            autoAdvanceToggle.onchange = saveProgress;


            prevPageButton.addEventListener('click', () => navigatePage('prev'));
            nextPageButton.addEventListener('click', () => navigatePage('next'));
            screenPrevArrow.addEventListener('click', () => navigatePage('prev'));
            screenNextArrow.addEventListener('click', () => navigatePage('next'));
            presentationModeToggle.addEventListener('click', togglePresentationMode);
            nextPanelButton.addEventListener('click', showNextPanelInPresentation);
            aiExploreButton.addEventListener('click', exploreConceptAI);
            galleryToggle.addEventListener('click', toggleGalleryView);

            const autoReadLabel = document.getElementById('autoReadToggleLabel'); if(autoReadLabel) autoReadLabel.classList.add('hidden');
            const autoAdvanceLabel = document.getElementById('autoAdvanceToggleLabel'); if(autoAdvanceLabel) autoAdvanceLabel.classList.add('hidden');
            
            document.addEventListener('keydown', (event) => {
                if (imageModal.style.display === 'flex' || aiExploreResultModal.style.display === 'flex' || continueModal.style.display === 'flex' || event.target.tagName === 'SELECT' || event.target.tagName === 'INPUT') return; 
                if (event.key === 'ArrowRight') { navigatePage('next'); } else if (event.key === 'ArrowLeft') { navigatePage('prev'); }
            });
            
            if (typeof speechSynthesis !== 'undefined') {
                if (speechSynthesis.onvoiceschanged !== undefined) {
                    speechSynthesis.onvoiceschanged = populateVoices;
                }
                populateVoices(); 
            }
            
            updateViewModeUI(); 
            loadProgress(); 
        }
        document.addEventListener('DOMContentLoaded', initialize);
    </script>
</body>
</html>
